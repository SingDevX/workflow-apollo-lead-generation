    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      allRows: items.map((row) => {\n        const industryArray = row.json[\"Industry Focus\"]\n          ? row.json[\"Industry Focus\"].split(\",\").map((i) => i.trim())\n          : [];\n\n        const targetRolesArray = row.json[\"Key Buyer Personas\"]\n          ? row.json[\"Key Buyer Personas\"].split(\",\").map((i) => i.trim())\n          : [];\n\n        const locationArray = row.json[\"Geography\"]\n          ? row.json[\"Geography\"].split(/,|&/).map((i) => i.trim())\n          : [];\n\n        const companyKeywordsArray = row.json[\n          \"Boolean Search Filter (Apollo/LinkedIn)\"\n        ]\n          ? row.json[\"Boolean Search Filter (Apollo/LinkedIn)\"]\n              .replace(/[()\"']/g, \"\")\n              .split(\" OR \")\n              .map((i) => i.trim())\n          : [];\n        return {\n          company: row.json[\"Client\"] || \"\",\n          region: row.json[\"Geography\"] || \"\",\n          industry: industryArray,\n          companySize: row.json[\"Target Company Size\"] || \"\",\n          targetRoles: targetRolesArray,\n          painPoints: row.json[\"Pain Points Solved\"]\n            ? row.json[\"Pain Points Solved\"].split(\",\").map((i) => i.trim())\n            : [],\n          dealSize: row.json[\"Tech Maturity\"] || \"\",\n          salesCycle: row.json[\"Sales Cycle\"] || \"\",\n          filters: {\n                        industry: industryArray,\n                        location: locationArray,\n                        company_keywords: companyKeywordsArray,\n                        jobTitles: targetRolesArray,\n                    },\n        };\n      }),\n    },\n  },\n];\n"
      },
