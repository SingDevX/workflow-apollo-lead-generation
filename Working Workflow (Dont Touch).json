        "jsCode": "const ICPData = $input.first().json.allRows;\n\n// Get persistent static data\nconst staticData = $getWorkflowStaticData('global');\nlet currentPage = staticData.apolloPage || 0;\n\n// Increment page\ncurrentPage++;\nstaticData.apolloPage = currentPage;\n\n// Build workflow items\nconst workflowItems = ICPData.map((item) => {\n  return {\n    json: {\n      ...item,\n      filters: {\n        ...(item.filters || {}),\n        page: currentPage,\n      },\n    },\n  };\n});\n\nreturn workflowItems;"
      },
